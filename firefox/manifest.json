{
  "manifest_version": 3,
  "name": "Numerology Tool",
  "version": "1.0",
  "description": "Pokazuje wartość numerologiczną zaznaczonego tekstu w menu kontekstowym. Format: zredukowana / surowa.",
  "browser_specific_settings": {
    "gecko": {
      "id": "numerology-tool@wpawlak",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "menus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
